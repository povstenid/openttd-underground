item(FEAT_TRAINS, metro_type_a, 512) {
    property {
        name:                         string(STR_NAME_METRO_TYPE_A);
        climates_available:           ALL_CLIMATES;
        introduction_date:            date(1935, 3, 1);
        model_life:                   30;
        vehicle_life:                 40;
        reliability_decay:            20;
        refittable_cargo_classes:     bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: bitmask();
        default_cargo_type:           PASS;
        cargo_capacity:               147;
        loading_speed:                20;
        cost_factor:                  16;
        running_cost_factor:          85;
        running_cost_base:            RUNNING_COST_ELECTRIC;
        sprite_id:                    SPRITE_ID_NEW_TRAIN;
        speed:                        65 km/h;
        power:                        410 hp;
        weight:                       44 ton;
        tractive_effort_coefficient:  0.25;
        track_type:                   MTRO;
        engine_class:                 ENGINE_CLASS_ELECTRIC;
        dual_headed:                  0;
        misc_flags:                   bitmask(TRAIN_FLAG_MU);
        visual_effect_and_powered:    visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
        length:                       8;
        extra_flags:                  bitmask(VEHICLE_FLAG_AUTOREFIT);
    }
    graphics {
        additional_text: string(STR_INFO_METRO_TYPE_A);
        purchase: set_a_both;
        sw_a_gfx;
    }
}

